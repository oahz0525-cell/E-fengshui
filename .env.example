# ── Vercel + Hono（部署到 Vercel 时务必加上）──────────────────────
# 不设则 POST（含 tRPC mutation）常在服务端 500；见 Vercel Node runtime 文档
NODEJS_HELPERS=0

# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend（构建时注入；可选）──────────────────────────────────
# 单次 AI 请求最长等待（毫秒），默认 52000，须小于 Vercel `api/trpc` 的 maxDuration
VITE_AI_CLIENT_TIMEOUT_MS=

# ── External APIs (server-only; users never configure these in the UI) ──
# 线上若要「多为 AI 文案」：至少配置 KIMI / DEEPSEEK / OPENAI 其一；全不设则服务端无法调用模型，只能用内置锦囊与模版
KIMI_API_KEY=             # Moonshot Kimi — AI 开运指南 & 寻地密语（首选）
KIMI_MODEL=               # 可选，默认 kimi-k2-turbo-preview；优先用官方推荐的较快型号，128k 往往更慢
DEEPSEEK_API_KEY=         # DeepSeek — Kimi 失败时的备选（OpenAI 兼容，按官网计费）
DEEPSEEK_MODEL=           # 默认 deepseek-chat；deepseek-reasoner 质量高但延迟明显更大
DEEPSEEK_BASE_URL=        # 可选，默认 https://api.deepseek.com/v1
GAODE_KEY=                # 高德 Web 服务 Key — 国内 POI 优先（可选，不设则用 Wikipedia）
GOOGLE_MAPS_API_KEY=      # （可选）Google Places — 当前寻地走路线 A（维基+OSM），此项未接入链路时可留空
OPENAI_API_KEY=           # 可选：Kimi 不可用时的 LLM 备选（OpenAI 兼容接口）
OPENAI_MODEL=             # 可选，默认 gpt-4o-mini
OPENAI_BASE_URL=          # 可选，默认 https://api.openai.com/v1
