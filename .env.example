# ── Vercel + Hono（部署到 Vercel 时务必加上）──────────────────────
# 不设则 POST（含 tRPC mutation）常在服务端 500；见 Vercel Node runtime 文档
NODEJS_HELPERS=0

# ── Backend（可选；仅 AI+tRPC 可不填，以免启动时报 Missing env）────────────────
APP_ID=
APP_SECRET=

# ── Database（未接 MySQL 可留空；调用 getDb() 时再报错）──────────────────
DATABASE_URL=

# ── Frontend（构建时注入；可选）──────────────────────────────────
# 开运指南/明日预言默认最多等 3000ms；若已配置 Key 且愿意久等 AI，可改为 45000～52000（须小于 api/trpc maxDuration）
VITE_AI_CLIENT_TIMEOUT_MS=

# ── External APIs (server-only; users never configure these in the UI) ──
# —— 怎样才能真正连上模型 API（部署 checklist）——
# 1) 在 Vercel（或 Docker）「服务端」环境变量里至少填：KIMI_API_KEY 或 GEMINI_API_KEY 或 OPENAI_API_KEY；保存后重新 Deploy。
# 2) Vercel 务必设 NODEJS_HELPERS=0，否则 POST /api/trpc 易 500。
# 3) Key 填在前端 .env 无效：AI 只在服务端调用，须在 Dashboard → Environment Variables（Production + Preview）。
# 4) 浏览器开发者工具 → Network：POST 到同源 /api/trpc/... 状态应为 200；若 401/500，查密钥是否过期、余额、模型名是否仍可用。
# 线上若要「多为 AI 文案」：至少配置其一；全不设则服务端无法调用模型，只能用本地锦囊与预言模版
KIMI_API_KEY=             # Moonshot Kimi — AI 开运指南 & 寻地密语（首选）
KIMI_MODEL=               # 可选，默认 kimi-k2-turbo-preview；优先用官方推荐的较快型号，128k 往往更慢
GEMINI_API_KEY=           # Google AI Studio / GCP — Kimi 失败时的备选（Gemini generateContent）
GEMINI_MODEL=             # 可选，默认 gemini-2.0-flash
GAODE_KEY=                # 高德 Web 服务 Key — 国内 POI 优先（可选，不设则用 Wikipedia）
GOOGLE_MAPS_API_KEY=      # （可选）Google Places — 当前寻地走路线 A（维基+OSM），此项未接入链路时可留空
OPENAI_API_KEY=           # 可选：Kimi 不可用时的 LLM 备选（OpenAI 兼容接口）
OPENAI_MODEL=             # 可选，默认 gpt-4o-mini
OPENAI_BASE_URL=          # 可选，默认 https://api.openai.com/v1
